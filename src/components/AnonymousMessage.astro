---
import { ANONYMOUS_MESSAGE_CONFIG } from "@/consts";

const {
  recipientEmail = ANONYMOUS_MESSAGE_CONFIG.recipientEmail,
  subtitle = ANONYMOUS_MESSAGE_CONFIG.subtitle,
  placeholder = ANONYMOUS_MESSAGE_CONFIG.placeholder,
  successMessage = ANONYMOUS_MESSAGE_CONFIG.successMessage,
  maxChars = ANONYMOUS_MESSAGE_CONFIG.maxChars,
} = Astro.props;
---

<div class="w-full max-w-xl mx-auto px-4">
  <!-- پنجره به سبک کارت‌های وبلاگ با ۳ دایره رترو -->
  <div
    class="w-full bg-gradient-to-br from-white/[0.002] to-white/[0.02] border-2 border-white rounded-lg overflow-hidden shadow-[0_0_20px_rgba(255,255,255,0.03)]"
  >
    <!-- نوار عنوان پنجره -->
    <div class="flex items-center justify-between px-4 py-2 bg-white/95 text-black">
      <div class="flex space-x-2">
        <div class="w-3 h-3 rounded-full bg-black"></div>
        <div class="w-3 h-3 rounded-full bg-black"></div>
        <div class="w-3 h-3 rounded-full bg-black"></div>
      </div>
      <div class="font-pixel text-[11px] tracking-widest opacity-80 uppercase select-none">
        whisper.exe
      </div>
    </div>

    <div class="p-5 md:p-7">
      <!-- راهنما / معرفی بخش -->
      <p
        class="text-white/80 font-pixel text-sm md:text-base text-center mb-5 leading-relaxed select-none"
        dir="auto"
      >
        {subtitle}
      </p>

      <!-- فرم پیام ناشناس -->
      <form
        id="anonymous-message-form"
        data-recipient={recipientEmail}
        data-max-chars={maxChars}
        class="space-y-4"
      >
        <!-- فیلد هانی‌پات ضد اسپم (مخفی برای ربات‌ها) -->
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

        <!-- فیلد نام مستعار (اختیاری) -->
        <div>
          <label
            for="sender-alias"
            class="block text-xs md:text-sm text-white/60 mb-1.5 font-pixel"
            dir="auto"
          >
            Who are you?
          </label>
          <input
            type="text"
            id="sender-alias"
            name="alias"
            maxlength="60"
            placeholder="A nameless Knight?"
            class="w-full bg-black/60 border border-white/30 focus:border-white focus:ring-1 focus:ring-white/40 text-white rounded px-3 py-2 text-xs md:text-sm font-pixel outline-none transition-all placeholder:text-white/20"
            dir="auto"
          />
        </div>

        <!-- متن پیام اصلی -->
        <div>
          <label
            for="message-content"
            class="block text-xs md:text-sm text-white/60 mb-1.5 font-pixel"
            dir="auto"
          >
            What is your story?:
          </label>
          <textarea
            id="message-content"
            name="message"
            rows="4"
            required
            maxlength={maxChars}
            placeholder={placeholder}
            class="w-full bg-black/60 border border-white/30 focus:border-white focus:ring-1 focus:ring-white/40 text-white rounded p-3 text-xs md:text-sm font-pixel outline-none transition-all resize-y placeholder:text-white/20 leading-relaxed"
            dir="auto"
          ></textarea>

          <!-- شمارنده کاراکترها و نشان امنیت -->
          <div class="flex justify-between items-center text-[11px] text-white/40 font-pixel mt-1 px-1">
            <span class="flex items-center gap-1 text-white/50 select-none">
              Completely anonymous
            </span>
            <span id="char-counter">۰ / {maxChars}</span>
          </div>
        </div>

        <!-- پیام خطا در صورت بروز مشکل -->
        <div
          id="form-error"
          class="hidden p-2.5 border border-red-500/50 bg-red-950/30 text-red-300 text-xs font-pixel text-center rounded transition-all"
        ></div>

        <!-- دکمه ارسال رترو -->
        <div class="pt-2 flex justify-center">
          <button
            type="submit"
            id="submit-button"
            class="px-8 py-2.5 border-2 border-white font-pixel text-xs md:text-sm cursor-pointer select-none transition-all duration-300 hover:bg-white hover:text-black active:scale-95 flex items-center justify-center gap-2 bg-transparent text-white"
          >
            <span id="btn-text">Send to Abyss</span>
            <span id="btn-spinner" class="hidden animate-spin">✦</span>
          </button>
        </div>
      </form>

      <!-- پنل موفقیت پس از ارسال -->
      <div
        id="form-success"
        class="hidden flex-col items-center justify-center py-6 text-center space-y-3"
      >
        <div class="text-3xl md:text-4xl animate-pulse select-none">☀️</div>
        <p
          class="text-white font-pixel text-sm md:text-base max-w-md leading-relaxed"
          dir="auto"
        >
          {successMessage}
        </p>
        <p class="text-xs text-white/50 font-pixel">
         The message is in the Abyss now.
        </p>
        <button
          type="button"
          id="send-another-btn"
          class="mt-3 px-5 py-1.5 border border-white/60 text-xs font-pixel hover:bg-white hover:text-black transition-all cursor-pointer"
        >
          Send another one?
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function setupAnonymousForm() {
    const form = document.getElementById("anonymous-message-form");
    const textarea = document.getElementById("message-content");
    const charCounter = document.getElementById("char-counter");
    const submitBtn = document.getElementById("submit-button");
    const btnText = document.getElementById("btn-text");
    const btnSpinner = document.getElementById("btn-spinner");
    const successPanel = document.getElementById("form-success");
    const errorPanel = document.getElementById("form-error");
    const sendAnotherBtn = document.getElementById("send-another-btn");

    if (!form || !textarea) return;

    if (form.dataset.hasListener === "true") return;
    form.dataset.hasListener = "true";

    const maxChars = parseInt(form.dataset.maxChars || "600", 10);
    const recipient = form.dataset.recipient || "0antuosh0@gmail.com";

    const updateCharCount = () => {
      const len = textarea.value.length;
      if (charCounter) {
        charCounter.textContent = `${len} / ${maxChars}`;
      }
    };

    textarea.addEventListener("input", updateCharCount);
    updateCharCount();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const message = textarea.value.trim();
      const aliasInput = document.getElementById("sender-alias");
      const alias = aliasInput ? aliasInput.value.trim() : "";
      const gotcha = form.querySelector('input[name="_gotcha"]');

      if (gotcha && gotcha.value) {
        return;
      }

      if (!message) {
        showError("لطفاً متنی برای ارسال بنویسید.");
        return;
      }

      setLoading(true);
      hideError();

      try {
        const response = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(recipient)}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            _subject: `💬 پیام ناشناس جدید از وبلاگ (${alias || "ناشناس"})`,
            "فرستنده (اختیاری)": alias || "کاملاً ناشناس (Anonymous)",
            "متن پیام": message,
            "زمان ارسال": new Date().toLocaleString("fa-IR"),
            _template: "table",
            _captcha: "false",
          }),
        });

        if (response.ok) {
          form.reset();
          updateCharCount();
          form.classList.add("hidden");
          successPanel.classList.remove("hidden");
          successPanel.classList.add("flex");
        } else {
          const result = await response.json().catch(() => ({}));
          const errMsg = result.message || "خطایی در ارسال رخ داد. لطفاً کمی بعد دوباره امتحان کن.";
          showError(errMsg);
        }
      } catch (err) {
        showError("ارتباط با سرویس برقرار نشد. لطفاً اتصال اینترنت خود را بررسی کنید.");
      } finally {
        setLoading(false);
      }
    });

    if (sendAnotherBtn) {
      sendAnotherBtn.addEventListener("click", () => {
        successPanel.classList.remove("flex");
        successPanel.classList.add("hidden");
        form.classList.remove("hidden");
        hideError();
        textarea.value = "";
        updateCharCount();
        textarea.focus();
      });
    }

    function setLoading(isLoading) {
      if (!submitBtn) return;
      submitBtn.disabled = isLoading;
      if (isLoading) {
        btnText.textContent ="The message is losing itself";
        btnSpinner.classList.remove("hidden");
        submitBtn.classList.add("opacity-70", "cursor-not-allowed");
      } else {
        btnText.textContent = "ارسال به تاریکی ❯";
        btnSpinner.classList.add("hidden");
        submitBtn.classList.remove("opacity-70", "cursor-not-allowed");
      }
    }

    function showError(msg) {
      if (!errorPanel) return;
      errorPanel.textContent = msg;
      errorPanel.classList.remove("hidden");
    }

    function hideError() {
      if (!errorPanel) return;
      errorPanel.textContent = "";
      errorPanel.classList.add("hidden");
    }
  }

  document.addEventListener("DOMContentLoaded", setupAnonymousForm);
  document.addEventListener("astro:page-load", setupAnonymousForm);
</script>