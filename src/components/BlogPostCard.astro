---
import type { CollectionEntry } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import DateComponent from "@/components/Date.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// ۱. دریافت Base URL بدون اسلش پایانی
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// ۲. اصلاح خودکار آدرس عکس کاور پست برای جلوگیری از ارور روتر و ۴۰۴
let formattedHeroImage = heroImage;
if (heroImage && !heroImage.startsWith("http") && !heroImage.startsWith(baseUrl)) {
  const cleanPath = heroImage.startsWith("/") ? heroImage : `/${heroImage}`;
  formattedHeroImage = `${baseUrl}${cleanPath}`;
}
---

<html lang="en" class="bg-black text-white">
  <head>
    <BaseHead title={title} description={description} image={formattedHeroImage} />
  </head>

  <body class="bg-black text-white min-h-screen flex flex-col justify-between selection:bg-white selection:text-black">
    <Navbar />

    <main class="w-full max-w-4xl mx-auto px-4 py-10 flex-1">
      <article class="prose prose-invert max-w-none">
        {
          formattedHeroImage && (
            <div class="mb-8 overflow-hidden rounded-lg border-2 border-white/20">
              <img
                src={formattedHeroImage}
                alt={title}
                class="w-full h-auto object-cover max-h-[450px]"
              />
            </div>
          )
        }

        <div class="mb-8 border-b border-white/10 pb-6">
          <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">
            {title}
          </h1>

          <div class="text-sm text-white/60 flex items-center gap-2">
            {pubDate && <DateComponent date={pubDate} />}
            {
              updatedDate && (
                <span class="italic text-xs text-white/40">
                  (آخرین ویرایش: <DateComponent date={updatedDate} />)
                </span>
              )
            }
          </div>

          {
            description && (
              <p class="text-lg text-white/80 mt-4 italic">
                {description}
              </p>
            )
          }
        </div>

        <!-- محتوای اصلی پست (Markdown) -->
        <div class="leading-relaxed space-y-6">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>