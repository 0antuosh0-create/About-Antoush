---
import { Image } from "astro:assets";
import HeroImg from "@/hero.png";
import { QUOTE, SITE_TITLE } from "@/consts";
---

<div class="hero-bg-animate pointer-events-none select-none absolute inset-0 -z-10 w-full h-full font-mono text-[10px] text-white/5 break-all overflow-hidden leading-none tracking-tighter hidden md:block"></div>

<section
  id="hero"
  class="relative w-full px-4 sm:px-8 pt-2 md:pt-6 pb-0 overflow-hidden"
>
  <div class="max-w-7xl w-full mx-auto grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-10 items-center">

    <!-- متن -->
    <div class="flex flex-col justify-center items-center text-center order-2 md:order-1">
      <h1
        id="hero-title"
        data-text={`<${SITE_TITLE} />`}
        class="font-bold text-4xl sm:text-5xl lg:text-7xl leading-tight tracking-tight break-words text-white cursor-default transition-all duration-500 hover:[text-shadow:0_0_14px_rgba(255,255,255,0.28)]"
      >
        {`<${SITE_TITLE} />`}
      </h1>

      <h2 class="text-base sm:text-lg md:text-xl text-white/70 mt-3 leading-relaxed font-light tracking-wide max-w-lg cursor-default transition-all duration-500 hover:text-white/95">
        {QUOTE}
      </h2>
    </div>

    <!-- تصویر: بزرگ بدون محدودیت ارتفاع -->
    <div class="flex justify-center items-center order-1 md:order-2 w-full">
      <Image
        alt="Hero"
        src={HeroImg}
        class="brightness-150 w-full h-auto object-contain max-w-[360px] sm:max-w-[520px] md:max-w-[780px] lg:max-w-[950px] invert drop-shadow-[0_0_30px_rgba(255,255,255,0.12)] transition-transform duration-700 hover:scale-[1.015]"
        priority
      />
    </div>

  </div>
</section>

<script is:inline>
  const hero_bg = document.querySelector(".hero-bg-animate");

  if (hero_bg) {
    let binaryText = "";
    const charCount = 2000;
    for (let i = 0; i < charCount; i++) {
      binaryText += Math.floor(Math.random() * 2).toString();
    }
    hero_bg.textContent = binaryText;

    setInterval(() => {
      const textArray = hero_bg.textContent.split("");
      for (let i = 0; i < 10; i++) {
        const randomIndex = Math.floor(Math.random() * textArray.length);
        textArray[randomIndex] = Math.floor(Math.random() * 2).toString();
      }
      hero_bg.textContent = textArray.join("");
    }, 250);
  }

  const title = document.getElementById("hero-title");
  if (title) {
    const originalText = title.dataset.text;
    const chars = "01";
    let scrambleInterval = null;
    let isAnimating = false;

    title.addEventListener("mouseenter", () => {
      if (isAnimating) return;
      isAnimating = true;
      let iteration = 0;
      clearInterval(scrambleInterval);

      scrambleInterval = setInterval(() => {
        title.textContent = originalText
          .split("")
          .map((char, index) => {
            if (char === " ") return " ";
            if (index < iteration) return originalText[index];
            if (index > iteration + 2) return originalText[index];
            return chars[Math.floor(Math.random() * chars.length)];
          })
          .join("");

        if (iteration >= originalText.length) {
          clearInterval(scrambleInterval);
          title.textContent = originalText;
          isAnimating = false;
        }
        iteration += 1;
      }, 50);
    });
  }
</script>