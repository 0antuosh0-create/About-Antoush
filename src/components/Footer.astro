---
import { SITE_TITLE } from "@/consts";

// لیست جملات دلخواه
const quotes = [
  "من اینجا بودم، از اینجا رفتم.",
  "Praise the Sun!",
  "Don't you dare go Hollow.",
  "وای!وای!وای!وای!ددم وای! نمیشم دیگه تو خودم جای",
  "حالا یاحق، یا هو منو دریاب ضامن اهو",
  "May the Dark shine your way.",
  "If only i could be so grossly incandescent.",
  "And the game is ON",
  "بــــا صدای بی صدا",
  "چرا مهر باید همی بر جهان چو باید خرامید با همرهان",
  "چو اندیشهٔ گنج گردد دراز همی گشت باید سوی خاک باز",
];
---

<div class="h-28 overflow-hidden select-none">
  <div class="hero-bg">
    
  </div>
</div>

<section
  id="footer"
  class="w-full grid relative place-items-center text-center py-4 bg-white/[0.001]"
>
  <div
    id="footer-card"
    class="px-10 py-3 border-2 border-white font-pixel cursor-pointer select-none transition-all duration-300 hover:border-zinc-400 hover:scale-105"
  >
    <span 
      id="footer-text" 
      class="inline-block transition-all duration-200 opacity-100"
      dir="auto"
      style="unicode-bidi: plaintext;"
    >
      من اینجا بودم، از اینجا رفتم.
    </span>
  </div>
</section>

<script data-quotes={JSON.stringify(quotes)}>
  const card = document.getElementById("footer-card");
  const textEl = document.getElementById("footer-text");
  const scriptTag = document.querySelector("script[data-quotes]");
  
  if (scriptTag && card && textEl) {
    const quotes = JSON.parse(scriptTag.dataset.quotes || "[]");
    let currentIndex = 0;
    let isAnimating = false;

    card.addEventListener("mouseenter", () => {
      if (isAnimating || quotes.length <= 1) return;
      isAnimating = true;

      // ۱. انیمیشن محو شدن
      textEl.classList.remove("opacity-100", "translate-y-0");
      textEl.classList.add("opacity-0", "translate-y-2");

      setTimeout(() => {
        // ۲. تعویض جمله
        currentIndex = (currentIndex + 1) % quotes.length;
        textEl.textContent = quotes[currentIndex];

        // ۳. انیمیشن ظاهر شدن
        textEl.classList.remove("opacity-0", "translate-y-2");
        textEl.classList.add("opacity-100", "translate-y-0");

        setTimeout(() => {
          isAnimating = false;
        }, 200);
      }, 200);
    });
  }
</script>