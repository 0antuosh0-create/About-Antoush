---
import { SITE_TITLE, NAV_LINKS as links } from "@/consts";

// دریافت Base URL از کانفیگ استرو (مثلا /About-Antoush)
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<nav class="w-full !z-[9999] py-5 px-4 bg-black/90 backdrop-blur-sm">
  <div
    class="w-full grid gap-4 md:px-5 place-items-center grid-cols-1 md:flex md:justify-between md:px-4"
  >
    <!-- لینک لوگو همراه با BASE_URL -->
    <a href={`${baseUrl}/`}>
      <div
        id="logo"
        class="pt-2 pb-1 !grid !place-items-center select-none leading-none hover:bg-black bg-white scale-110 hover:text-white text-black px-4 transition-all ease-in-out"
      >
        {SITE_TITLE}
      </div>
    </a>
    <div class="flex flex-wrap gap-4 md:pr-5">
      <div class="hidden md:block">/</div>
      {
        links.map((link) => {
          // تشخیص لینک‌های خارجی
          const isExternal = link.href?.startsWith("http") || link.href?.startsWith("//");

          // استخراج مسیر خام لینک
          const rawHref = link.href ?? link.title.toLowerCase().replaceAll(" ", "-");
          const internalPath = rawHref.startsWith("/") ? rawHref : `/${rawHref}`;

          // مقداردهی صحیح به href نهایی
          const finalHref = isExternal ? rawHref : `${baseUrl}${internalPath}`;

          // محاسبه مسیر فعلی برای هایلایت شدن لینک فعال
          const pathname = Astro.url.pathname;
          const cleanPathname = pathname.replace(baseUrl, "") || "/";
          const subpath = cleanPathname.match(/[^\/]+/g);
          
          const isActive =
            !isExternal && 
            (internalPath === cleanPathname || (internalPath !== "/" && internalPath === "/" + (subpath?.[0] || "")));

          return (
            <>
              <a
                class:list={[{ "bg-white text-black": isActive }]}
                class="hover:bg-white hover:text-black transition-all ease-in-out px-2 max-w-fit"
                href={finalHref}
                target={isExternal ? "_blank" : "_self"}
                rel={isExternal ? "noopener noreferrer" : undefined}
              >
                <div>{link.title}</div>
              </a>
              <div class="hidden md:block">/</div>
            </>
          );
        })
      }
    </div>
  </div>
</nav>

<script>
  function setupLogoScroll() {
    const logo = document.getElementById("logo");
    if (!logo) return;

    window.addEventListener("scroll", () => {
      if (window.scrollY > 100) {
        logo.className =
          "pt-2 pb-1 !grid !place-items-center select-none leading-none hover:bg-white bg-black scale-100 hover:text-black text-white px-4 transition-all ease-in-out";
      } else {
        logo.className =
          "pt-2 pb-1 !grid !place-items-center select-none leading-none hover:bg-black bg-white scale-110 hover:text-white text-black px-4 transition-all ease-in-out";
      }
    });
  }

  // اجرای اسکریپت در اولین بارگذاری و هنگام تعویض صفحات با View Transitions
  setupLogoScroll();
  document.addEventListener("astro:page-load", setupLogoScroll);
</script>